# Gate every push on: clean lint → clean type-check → green E2E suite.
# Any step failing aborts the push (set -e). The order is cheapest-first so a
# lint/type error fails in seconds instead of after the ~9-10 min test run.
# Bypass with `git push --no-verify` only if you already ran these locally and
# understand why bypassing is safe.
set -e

echo "→ Lint (eslint)…"
npm run lint

echo "→ Type-check (tsc --noEmit)…"
npx tsc --noEmit

echo "→ E2E test suite (takes ~9-10 minutes)…"
npm run test:e2e
